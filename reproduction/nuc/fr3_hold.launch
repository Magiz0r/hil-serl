<?xml version="1.0"?>
<launch>
  <!-- ACTIVE TORQUE CONTROL: requires an attended, explicitly approved run.
       The controller starts with the measured pose as its equilibrium.
       franka_control also writes the image's collision_config on connection.
       Use only the pinned image documented in PREFLIGHT.md. -->
  <arg name="robot_ip" default="172.16.0.1" />

  <!-- Keep historical clients' usual target topic outside this hold test. -->
  <remap from="/cartesian_impedance_controller/equilibrium_pose"
         to="/hil_serl_preflight/unused_equilibrium_pose" />

  <include file="$(find franka_control)/launch/franka_control.launch">
    <arg name="robot_ip" value="$(arg robot_ip)" />
    <arg name="robot" value="fr3" />
    <arg name="arm_id" value="fr3" />
    <arg name="load_gripper" value="false" />
  </include>

  <!-- Do not load the historical SERL YAML, which hard-codes panda joints. -->
  <rosparam ns="cartesian_impedance_controller">
    type: serl_franka_controllers/CartesianImpedanceController
    arm_id: fr3
    joint_names: [fr3_joint1, fr3_joint2, fr3_joint3, fr3_joint4,
                  fr3_joint5, fr3_joint6, fr3_joint7]
  </rosparam>
  <node name="hil_serl_hold_spawner" pkg="controller_manager" type="spawner"
        args="cartesian_impedance_controller" output="screen"
        respawn="false" required="true" />
</launch>
